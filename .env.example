# Supabase — usado a partir da etapa de lançamentos, autenticação e dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cron diário de notificações push (/api/cron/notificacoes, ver vercel.json).
# A Vercel manda "Authorization: Bearer <CRON_SECRET>" nas chamadas agendadas.
CRON_SECRET=
# Supabase — usado a partir da etapa de lançamentos, autenticação e dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cron diário de notificações push (/api/cron/notificacoes, ver vercel.json).
# A Vercel manda "Authorization: Bearer <CRON_SECRET>" nas chamadas agendadas.
CRON_SECRET=

# Sessão em cookie httpOnly + proteção de rotas no servidor (apuração de
# segurança 10/out/2026, itens 3 e 5). "1" liga; vazio/qualquer outro valor
# mantém o comportamento antigo (sessão no localStorage).
# ATENÇÃO ao desligar depois de ligado: todo mundo precisa entrar de novo.
NEXT_PUBLIC_SESSAO_COOKIE=
